# ==============================================================================
# PLATAFORMA GESTIÓN DE SOLICITUDES - GERENCIA DE DATOS BNB (FASE 1)
# Archivo de variables de entorno maestro (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# ENTORNO GENERAL
# ------------------------------------------------------------------------------
# Precedencia (Rodrigo): variables del sistema < .env raíz < apps/api/.env
# Si el mismo nombre existe en varios sitios, gana apps/api/.env. dotenv usa override: true.
# Ubicación aceptada: este archivo (raíz del monorepo) y/o apps/api/.env (opcional, local API).
NODE_ENV=development
PORT=3005
API_PREFIX=api/v1
APP_NAME="BNB Gerencia de Datos - Gestión de Solicitudes"
APP_URL=http://localhost:5173
API_URL=http://localhost:3005

# ------------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL con Prisma)
# Nota: Si la instancia local de PostgreSQL no está disponible durante el build/test,
# Prisma se valida sin conexión y los tests unitarios ejecutan mocks en memoria.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bnb_tickets_dev?schema=public

# ------------------------------------------------------------------------------
# SEED DE ADMINISTRADOR (producción / primer arranque)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@bnb.com.bo
ADMIN_FULL_NAME="Administrador del Sistema"
ADMIN_AREA=Tecnología
# ADMIN_PASSWORD=  # Si se omite, seed:admin genera una clave segura (visible solo con SEED_MOSTRAR_CONTRASENAS=1 o --mostrar-contrasenas)

# ------------------------------------------------------------------------------
# SEED DEMO (desarrollo / npm run seed:demo)
# ------------------------------------------------------------------------------
# DEMO_SEED_PASSWORD=  # Contraseña compartida de usuarios demo; necesaria para npm run test:integration

# ------------------------------------------------------------------------------
# AUTENTICACIÓN Y SEGURIDAD (Argon2id + Sesiones / JWT)
# ------------------------------------------------------------------------------
# Secretos obligatorios en producción. Déjelos vacíos en dev y ejecute:
#   npm run secretos:generar   (o scripts/generar-secretos.sh / .ps1)
# No se imprimen en consola al generarlos.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SESSION_COOKIE_SECRET=

# Tiempos de expiración
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
SESSION_TTL_HOURS=168

# Política de Bloqueo por Intentos Fallidos (Lockout)
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Cookie settings
COOKIE_NAME=bnb_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=localhost

# ------------------------------------------------------------------------------
# CSRF Y SEGURIDAD DE RED
# ------------------------------------------------------------------------------
CSRF_SECRET=
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# RATE LIMITING (Throttler NestJS)
# ------------------------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=10

# ------------------------------------------------------------------------------
# ALMACENAMIENTO LOCAL (Sin S3 / Cloud / Pagos)
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=../../storage/uploads
STORAGE_AVATARS_PATH=../../storage/avatars

# ------------------------------------------------------------------------------
# CLIENTE WEB (Vite - variables públicas con prefijo VITE_)
# ------------------------------------------------------------------------------
# En desarrollo use el proxy de Vite (misma origen, cookies y avatares). En producción, URL pública del API.
VITE_API_URL=/api/v1
VITE_APP_TITLE="BNB Datos - Solicitudes"
# Opcional: target explícito del proxy /api (si no se define, Vite usa http://127.0.0.1:${PORT} y si falta PORT, 3000).
# VITE_API_PROXY_TARGET=http://127.0.0.1:3005
