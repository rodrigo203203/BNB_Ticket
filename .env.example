# ==============================================================================
# PLATAFORMA GESTIÓN DE SOLICITUDES - GERENCIA DE DATOS BNB (FASE 1)
# Archivo de variables de entorno maestro (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# ENTORNO GENERAL
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME="BNB Gerencia de Datos - Gestión de Solicitudes"
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL con Prisma)
# Nota: Si la instancia local de PostgreSQL no está disponible durante el build/test,
# Prisma se valida sin conexión y los tests unitarios ejecutan mocks en memoria.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bnb_tickets_dev?schema=public

# ------------------------------------------------------------------------------
# AUTENTICACIÓN Y SEGURIDAD (Argon2id + Sesiones / JWT)
# ------------------------------------------------------------------------------
# Secretos para firma de tokens y cookies de sesión HttpOnly
JWT_ACCESS_SECRET=bnb_super_secret_access_token_key_change_in_production_min_32_chars!
JWT_REFRESH_SECRET=bnb_super_secret_refresh_token_key_change_in_production_min_32_chars!
SESSION_COOKIE_SECRET=bnb_cookie_secret_for_signed_cookies_must_be_very_long_32chars!

# Tiempos de expiración
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
SESSION_TTL_HOURS=168

# Política de Bloqueo por Intentos Fallidos (Lockout)
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Cookie settings
COOKIE_NAME=bnb_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=localhost

# ------------------------------------------------------------------------------
# CSRF Y SEGURIDAD DE RED
# ------------------------------------------------------------------------------
CSRF_SECRET=bnb_csrf_secret_key_minimum_32_characters_long_for_security!
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# RATE LIMITING (Throttler NestJS)
# ------------------------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=10

# ------------------------------------------------------------------------------
# ALMACENAMIENTO LOCAL (Sin S3 / Cloud / Pagos)
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=../../storage/uploads
STORAGE_AVATARS_PATH=../../storage/avatars

# ------------------------------------------------------------------------------
# CLIENTE WEB (Vite - variables públicas con prefijo VITE_)
# ------------------------------------------------------------------------------
# En desarrollo use el proxy de Vite (misma origen, cookies y avatares). En producción, URL pública del API.
VITE_API_URL=/api/v1
VITE_APP_TITLE="BNB Datos - Solicitudes"
