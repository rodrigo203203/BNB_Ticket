    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.8.7",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
