{
  "name": "bnb-gerencia-datos-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma BNB de Gestión de Solicitudes - Gerencia de Datos (Fase 1)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,blue \"npm run dev --workspace=@bnb/api\" \"npm run dev --workspace=@bnb/web\"",
    "dev:api": "npm run dev --workspace=@bnb/api",
    "dev:web": "npm run dev --workspace=@bnb/web",
    "build": "npm run build --workspace=@bnb/shared && npm run build --workspace=@bnb/api && npm run build --workspace=@bnb/web",
    "build:shared": "npm run build --workspace=@bnb/shared",
    "build:api": "npm run build --workspace=@bnb/api",
    "build:web": "npm run build --workspace=@bnb/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:cov --workspace=@bnb/api",
    "prisma:validate": "npm run prisma:validate --workspace=@bnb/api",
    "prisma:generate": "npm run prisma:generate --workspace=@bnb/api",
    "prisma:migrate:dev": "npm run prisma:migrate:dev --workspace=@bnb/api",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace=@bnb/api",
    "seed": "npm run seed:admin --workspace=@bnb/api",
    "seed:admin": "npm run seed:admin --workspace=@bnb/api",
    "seed:demo": "npm run seed:demo --workspace=@bnb/api",
    "admin:reset": "npm run admin:reset --workspace=@bnb/api",
    "verify:env": "node scripts/verify-env.mjs",
    "secretos:generar": "node scripts/generar-secretos.mjs",
    "test:generar-secretos": "node --test scripts/generar-secretos.spec.mjs",
    "test:scripts": "bash scripts/lib/cargar-env.spec.sh && bash scripts/offline/verificar-binarios-win-paquete.spec.sh",
    "test:integration": "bash scripts/test-integration-preflight.sh && npm run prisma:migrate:deploy && npm run seed:demo && RUN_DB_TESTS=1 npm test --workspace=@bnb/api -- --testPathPattern=integration"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "typescript": "^5.7.3",
    "vue-eslint-parser": "^10.4.2"
  },
  "engines": {
    "node": ">=20"
  }
}
